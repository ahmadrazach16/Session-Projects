# --- General ---
APP_NAME=Library Management System
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# --- Database ---
# Used directly by the app when running outside Docker
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/library_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Used by docker-compose.yml to configure the Postgres container
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=library_db
DB_PORT=5432

# --- JWT / Security ---
# IMPORTANT: generate a strong random value in production, e.g.:
#   openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Business rules ---
LOAN_PERIOD_DAYS=14
FINE_PER_DAY=10.0
MAX_ACTIVE_LOANS_PER_MEMBER=3

# --- CORS ---
ALLOWED_ORIGINS=*

# --- Logging ---
LOG_LEVEL=INFO
